generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String     @db.NVarChar(255)
  email     String     @unique @db.NVarChar(255)
  password  String?    @db.NVarChar(255)
  avatar    String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  accounts  Account[]
  articles  Article[]
  sessions  Session[]
  roles     UserRole[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.NVarChar(100)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    Int              @id @default(autoincrement())
  name  String           @unique @db.NVarChar(150)
  roles RolePermission[]
}

model UserRole {
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String  @db.NVarChar(50)
  provider          String  @db.NVarChar(50)
  providerAccountId String  @db.NVarChar(255)
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  token_type        String? @db.NVarChar(50)
  scope             String? @db.NVarChar(255)
  id_token          String? @db.NVarChar(Max)
  session_state     String? @db.NVarChar(255)
  expires_at        Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @db.NVarChar(255)
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String   @db.NVarChar(255)
  token      String   @db.NVarChar(255)
  expires    DateTime

  @@id([identifier, token])
}

model Specialty {
  id        Int      @id @default(autoincrement())
  label     String   @db.NVarChar(255)
  en        String   @db.NVarChar(255)
  slug      String   @unique @db.NVarChar(255)
  code      String   @unique @db.NVarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctors   Doctor[]
}

model Doctor {
  id          Int                @id @default(autoincrement())
  name        String             @db.NVarChar(255)
  slug        String             @unique @db.NVarChar(255)
  location    String             @db.NVarChar(255)
  bio         String?            @db.NVarChar(Max)
  experience  String             @db.NVarChar(255)
  price       Int?
  isOnline    Boolean            @default(false)
  isActive    Boolean            @default(true)
  rating      Float              @default(0)
  reviews     Int                @default(0)
  image       String?
  specialtyId Int
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  specialty   Specialty          @relation(fields: [specialtyId], references: [id])
  experiences DoctorExperience[]
  educations  Education[]
  schedules   Schedule[]

  @@index([specialtyId])
  @@index([slug])
  @@index([isActive])
}

model Schedule {
  id        Int    @id @default(autoincrement())
  day       Int
  startTime Int
  endTime   Int
  doctorId  Int
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([day])
}

model Education {
  id         Int    @id @default(autoincrement())
  degree     String @db.NVarChar(255)
  university String @db.NVarChar(255)
  doctorId   Int
  doctor     Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model DoctorExperience {
  id          Int    @id @default(autoincrement())
  startYear   Int
  endYear     Int?
  title       String @db.NVarChar(255)
  place       String @db.NVarChar(255)
  description String @db.NVarChar(Max)
  doctorId    Int
  doctor      Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

/// ///////////////////
/// ///////////////////
model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  articles  Article[]
}

model ArticleTag {
  articleId Int
  tagId     Int
  article   Article @relation(fields: [articleId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

model Article {
  id           Int           @id @default(autoincrement())
  title        String        @db.NVarChar(255)
  slug         String        @unique @db.NVarChar(255)
  excerpt      String        @db.NVarChar(Max)
  content      String        @db.NVarChar(Max)
  thumbnail    String?
  published    Boolean       @default(false)
  publishedAt  DateTime?
  authorId     Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  views        Int           @default(0)
  categoryId   Int
  author       User          @relation(fields: [authorId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  tags         ArticleTag[]
  articleViews ArticleView[]

  @@index([published])
  @@index([views])
  @@index([categoryId])
}

model ArticleView {
  id        Int      @id @default(autoincrement())
  articleId Int
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  sessionId String?
  article   Article  @relation(fields: [articleId], references: [id])

  @@index([articleId])
  @@index([sessionId])
}

model Promo {
  id          Int       @id @default(autoincrement())
  title       String    @db.NVarChar(255)
  slug        String    @unique @db.NVarChar(255)
  description String    @db.NVarChar(Max)
  image       String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model HospitalProfile {
  id          Int      @id @default(1)
  name        String   @db.NVarChar(255)
  address     String   @db.NVarChar(500)
  phone       String   @db.NVarChar(50)
  email       String   @db.NVarChar(255)
  description String   @db.NVarChar(Max)
  logo        String?
  updatedAt   DateTime @updatedAt
}

model UserTest {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model Job {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  shortDescription String
  description      String
  locationCity     String
  locationCountry  String
  employmentType   String
  workplaceType    String
  experienceLevel  String
  salaryMin        Int?
  salaryMax        Int?
  currency         String?
  educationLevel   String
  priority         String
  isUrgent         Boolean          @default(false)
  postedAt         DateTime         @default(now())
  deadline         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  departement      String?
  urgentReason     String?
  applicants       Applicant[]
  benefits         JobBenefit[]
  requirements     JobRequirement[]
  skills           JobSkill[]

  @@index([slug])
  @@index([locationCity])
}

model JobBenefit {
  id    String @id @default(cuid())
  value String
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobRequirement {
  id    String @id @default(cuid())
  value String
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Skill {
  id   String     @id @default(cuid())
  name String     @unique
  jobs JobSkill[]
}

model JobSkill {
  jobId   String
  skillId String
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

model Applicant {
  id        String   @id @default(cuid())
  jobId     String
  fullName  String
  email     String
  resumeUrl String?
  status    String   @default("PENDING")
  appliedAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
